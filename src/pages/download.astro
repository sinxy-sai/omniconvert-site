---
import Layout from '../layouts/Layout.astro';
import { releases } from '../lib/releases';
import manifest from '../../public/releases/latest.json';
const published = new Map(manifest.releases.map((item) => [item.platform, item]));
---
<Layout title="下载"><div class="container"><div class="eyebrow">Downloads</div><h1>选择你的平台</h1><p class="lede">正式产物会显示版本、架构、大小、SHA-256 和签名；尚未发布的平台会明确标记。</p><div class="section grid">{releases.map((release) => { const item = published.get(release.platform.toLowerCase().split(' ')[0]); return <article class="panel"><div class="kicker">{release.platform}</div><h2>{item?.version ?? release.version}</h2><p><strong>架构：</strong>{item?.arch ?? release.arch}</p><p class="muted">{item ? item.releaseNotes : release.note}</p>{item ? <><p class="kicker">SHA-256：{item.sha256}</p><a class="button primary" href={item.downloadUrl}>下载 / 打开</a></> : <span class="button">尚未发布</span>}</article>; })}</div><div class="section callout"><strong>iOS：</strong>第一阶段使用 Web/PWA，不提供公开原生 IPA 安装。</div></div></Layout>
